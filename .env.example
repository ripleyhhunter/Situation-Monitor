# =======================================
#  Situation Monitor - environment example
# =======================================
# Copy to .env and edit. Empty/unset values are fine — the app degrades
# gracefully when optional APIs aren't configured.

# --- Region ---------------------------------------------------------------
# The backend fetches ALL regions (see packages/backend/src/regions/) and the
# user can switch in the UI. These only pick the *initial/default* region.
# Supported: dc, boise. Default: dc.
REGION=dc
# Initial region selection baked into the frontend build (user choice persists
# in localStorage after that).
PUBLIC_REGION=dc

# --- Backend --------------------------------------------------------------
NODE_ENV=development
PORT=3000
REDIS_URL=redis://localhost:6379

# --- API Keys (all optional) ----------------------------------------------
# WMATA Metro alerts — only used when REGION=dc. https://developer.wmata.com/
WMATA_API_KEY=
# Air quality (any region) — https://docs.airnowapi.org/
AIRNOW_API_KEY=
# Twitter/X feed for fire/EMS account — DC only, requires $100/mo Basic tier.
TWITTER_BEARER_TOKEN=
# OpenSky Network OAuth2 (any region) — https://opensky-network.org/ -> Account
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- DC proximity anchor (backend) ----------------------------------------
# Used ONLY by the MD CHART fetchers as the center of their 80km include
# radius. The frontend map centers come from the region presets in
# $lib/config, NOT from these. Leave unset (defaults to DC center) unless you
# want to shift which Maryland incidents/cameras are considered in-area.
# WARNING: setting non-DC coordinates here silently empties the MD CHART feeds.
PUBLIC_DEFAULT_LAT=
PUBLIC_DEFAULT_LNG=

# --- Frontend -> backend wiring ------------------------------------------
# Empty = same-origin. Set to a URL when frontend is hosted separately
# (e.g. GitHub Pages hitting a local backend or Cloudflare tunnel).
PUBLIC_API_URL=

# --- Backend CORS (production only) --------------------------------------
# Comma-separated origin list. Ignored when NODE_ENV != production.
CORS_ORIGINS=

# =======================================
#  Region presets reference (hardcoded in packages/frontend/src/lib/config.ts)
# =======================================
# dc:    center 38.9072, -77.0369  — America/New_York
# boise: center 43.6150, -116.2023 — America/Boise
