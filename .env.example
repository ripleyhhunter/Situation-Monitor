# =======================================
#  Situation Monitor - environment example
# =======================================
# Copy to .env and edit. Empty/unset values are fine — the app degrades
# gracefully when optional APIs aren't configured.

# --- Region ---------------------------------------------------------------
# Picks the bundle of fetchers + map defaults the app runs. Supported: dc, boise.
# Defaults to dc when unset. See packages/backend/src/regions/ for the packs.
REGION=dc
# Frontend label shown next to the title ("DC", "Boise", custom city, etc.)
PUBLIC_REGION=dc
PUBLIC_REGION_LABEL=

# --- Backend --------------------------------------------------------------
NODE_ENV=development
PORT=3000
REDIS_URL=redis://localhost:6379

# --- API Keys (all optional) ----------------------------------------------
# WMATA Metro alerts — only used when REGION=dc. https://developer.wmata.com/
WMATA_API_KEY=
# Air quality (any region) — https://docs.airnowapi.org/
AIRNOW_API_KEY=
# Twitter/X feed for fire/EMS account — DC only, requires $100/mo Basic tier.
TWITTER_BEARER_TOKEN=
# OpenSky Network OAuth2 (any region) — https://opensky-network.org/ -> Account
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- Map defaults (frontend) ---------------------------------------------
# When unset, fall back to the region's preset center/zoom (see $lib/config).
# Override these when deploying to a custom center within a region.
PUBLIC_DEFAULT_LAT=
PUBLIC_DEFAULT_LNG=
PUBLIC_DEFAULT_ZOOM=

# --- Frontend -> backend wiring ------------------------------------------
# Empty = same-origin. Set to a URL when frontend is hosted separately
# (e.g. GitHub Pages hitting a local backend or Cloudflare tunnel).
PUBLIC_API_URL=

# --- Backend CORS (production only) --------------------------------------
# Comma-separated origin list. Ignored when NODE_ENV != production.
CORS_ORIGINS=

# =======================================
#  Region presets reference
# =======================================
# REGION=dc:
#   PUBLIC_DEFAULT_LAT=38.9072
#   PUBLIC_DEFAULT_LNG=-77.0369
#   Timezone: America/New_York
#
# REGION=boise:
#   PUBLIC_DEFAULT_LAT=43.6150
#   PUBLIC_DEFAULT_LNG=-116.2023
#   Timezone: America/Boise
